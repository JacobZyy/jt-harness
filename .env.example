# Copy to .env. This file is a template; never paste real keys into it.
JTH_DATABASE_URL=postgresql://localhost/jth
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# Optional: legacy DSH imports only; normal record/work never calls DSH.
# JTH_DSH_PROVIDER=your-provider
# JTH_DSH_MODEL=your-model
# JTH_DATA_DIR=/absolute/path/to/jth-data
