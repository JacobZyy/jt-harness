# User configuration defaults to ~/.jt-harness/.env; jth init fills missing values.
# This file is a template; never paste real keys into it.
JTH_DATABASE_URL=postgresql://localhost/jth
# Optional: manage this explicitly selected existing local PostgreSQL cluster.
# Unset means an external instance: connect only, never start or stop it.
# JTH_PG_DATA_DIR=/absolute/path/to/jth/postgres
# JTH_PG_BIN_DIR=/opt/homebrew/opt/postgresql@18/bin
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# Optional: override the default DSH extraction provider/model.
# JTH_DSH_PROVIDER=your-provider
# JTH_DSH_MODEL=your-model
# JTH_DATA_DIR=/absolute/path/to/jth-data
